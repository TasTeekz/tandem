# Copy to .env and fill in. .env is git-ignored and blocked for Claude in .claude/settings.json.
# Async driver is required: postgresql+asyncpg://user:pass@host:5432/dbname
POSTGRES_URL=postgresql+asyncpg://user:password@localhost:5432/tandem
JWT_SECRET=change-me-to-a-long-random-string-32-chars-min
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=14
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=10
# Seeded on first start if no admin exists
ADMIN_EMAIL=admin@tandem.app
ADMIN_PASSWORD=change-me-admin
