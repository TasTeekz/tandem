{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.production)",
      "Write(**/.env)",
      "Write(**/.env.local)",
      "Write(**/.env.*.local)",
      "Write(**/.env.production)",
      "Bash(cat *.env)",
      "Bash(cat **/.env)",
      "Bash(type *.env)",
      "Bash(more *.env)",
      "Bash(head *.env)",
      "Bash(tail *.env)",
      "Bash(grep * .env)",
      "Bash(rg * .env)",
      "Bash(sed * .env)",
      "Bash(cp * .env)",
      "Bash(mv * .env)",
      "Bash(rm *.env)",
      "Bash(echo * > .env)",
      "Bash(echo * >> .env)",
      "Bash(source .env)",
      "Bash(. .env)",
      "PowerShell(Get-Content *.env)",
      "PowerShell(gc *.env)",
      "PowerShell(type *.env)",
      "PowerShell(Set-Content *.env*)",
      "PowerShell(Add-Content *.env*)",
      "PowerShell(Remove-Item *.env)"
    ]
  }
}
